{
  "name": "@vytches/eslint-plugin-ddd",
  "version": "0.32.0",
  "description": "ESLint plugin (flat config) with a DDD role model for @vytches/ddd and a feedback lane for coding agents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent.js",
      "require": "./dist/agent.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "agent": [
        "./dist/agent/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md",
    "LLMGUIDE.md",
    "LICENSE"
  ],
  "keywords": [
    "ddd",
    "domain-driven-design",
    "typescript",
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "flat-config"
  ],
  "author": "VytchesDDD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vytches/ddd.git",
    "directory": "packages/eslint-plugin-ddd"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/node": "^20.19.1",
    "@typescript-eslint/parser": "^8.68.0",
    "@vytches/ddd-acl": "workspace:*",
    "@vytches/ddd-aggregates": "workspace:*",
    "@vytches/ddd-contracts": "workspace:*",
    "@vytches/ddd-cqrs": "workspace:*",
    "@vytches/ddd-di": "workspace:*",
    "@vytches/ddd-domain-primitives": "workspace:*",
    "@vytches/ddd-domain-services": "workspace:*",
    "@vytches/ddd-events": "workspace:*",
    "@vytches/ddd-messaging": "workspace:*",
    "@vytches/ddd-policies": "workspace:*",
    "@vytches/ddd-projections": "workspace:*",
    "@vytches/ddd-repositories": "workspace:*",
    "@vytches/ddd-resilience": "workspace:*",
    "@vytches/ddd-utils": "workspace:*",
    "@vytches/ddd-validation": "workspace:*",
    "@vytches/ddd-value-objects": "workspace:*",
    "eslint": "^9.39.0",
    "fast-check": "^4.7.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.2",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.1.0"
  },
  "nx": {
    "tags": [
      "scope:eslint-plugin",
      "type:lib",
      "layer:tooling"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
