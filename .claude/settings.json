{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "symlinkDirectories": ["node_modules"]
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(src/**)",
      "Edit(packages/**)",
      "Edit(test/**)",
      "Edit(tests/**)",
      "Edit(.claude/**)",
      "Write(src/**)",
      "Write(packages/**)",
      "Write(test/**)",
      "Write(tests/**)",
      "Write(.claude/**)",
      "Write(docs/**)",
      "MultiEdit(src/**)",
      "MultiEdit(packages/**)",
      "MultiEdit(test/**)",
      "MultiEdit(tests/**)",
      "Bash(pnpm *)",
      "Bash(git *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(mkdir *)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)",
      "Bash(pnpm publish *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/hooks/statusline-pm.js\""
  },
  "autoMode": {
    "environment": [
      "Shared TypeScript npm library (Nx monorepo with multiple packages).",
      "All public API changes must maintain backward compatibility.",
      "Every exported class/function must have corresponding unit tests.",
      "Dual ESM/CJS build output, tree-shaking support required."
    ],
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(src/**)",
      "Edit(packages/**)",
      "Edit(test/**)",
      "Edit(tests/**)",
      "Write(src/**)",
      "Write(packages/**)",
      "Write(test/**)",
      "Write(tests/**)",
      "MultiEdit(src/**)",
      "MultiEdit(packages/**)",
      "MultiEdit(test/**)",
      "MultiEdit(tests/**)",
      "Bash(pnpm test *)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm tsc --noEmit *)",
      "Bash(pnpm nx *)",
      "Bash(pnpm vitest *)"
    ],
    "soft_deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(pnpm publish *)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/subagent-stop-cost-log.js\"",
            "async": true
          }
        ],
        "description": "Log per-agent token usage + branch to ~/.claude/logs/agent-usage.jsonl. Disable: AGENT_USAGE_LOG=off"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-approval-before-impl.js\""
          }
        ],
        "description": "Blok approval-gate (runtime.yml): ostrzega przy edycji kodu, gdy artefakt analizy nie ma status: approved. Tryby: ORCHESTRATE_DDD_GATE=warn|block|off"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/post-edit-format.js\""
          }
        ],
        "description": "Auto-format after edits"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/post-edit-typecheck.js\""
          }
        ],
        "description": "TypeScript check after editing .ts files"
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/pm-task-check.js\""
          }
        ],
        "description": "PM health check when task files change"
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/opt/projects/claude-patterns/hooks/check-human-voice.js\""
          }
        ],
        "description": "check-human-voice (zdarzenie odczytane z nagłówka hooka)"
      }
    ]
  }
}
